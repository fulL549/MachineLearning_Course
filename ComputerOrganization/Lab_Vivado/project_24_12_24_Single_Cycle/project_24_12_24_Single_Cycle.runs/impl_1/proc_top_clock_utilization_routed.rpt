# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y3 [get_cells pc2_reg[31]_i_1]
set_property LOC BUFGCTRL_X0Y2 [get_cells rf_reg_r1_0_31_0_5_i_1]
set_property LOC BUFGCTRL_X0Y0 [get_cells clk_run_o_BUFG_inst]
set_property LOC BUFGCTRL_X0Y1 [get_cells clk_i_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y26 [get_ports clk_i]

# Clock net "u_mips/u_datapath/flag0" driven by instance "pc2_reg[31]_i_1" located at site "BUFGCTRL_X0Y3"
#startgroup
create_pblock {CLKAG_u_mips/u_datapath/flag0}
add_cells_to_pblock [get_pblocks  {CLKAG_u_mips/u_datapath/flag0}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_mips/u_datapath/flag0"}]]]
resize_pblock [get_pblocks {CLKAG_u_mips/u_datapath/flag0}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

# Clock net "u_mips/u_datapath/clk" driven by instance "rf_reg_r1_0_31_0_5_i_1" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_u_mips/u_datapath/clk}
add_cells_to_pblock [get_pblocks  {CLKAG_u_mips/u_datapath/clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_mips/u_datapath/clk"}]]]
resize_pblock [get_pblocks {CLKAG_u_mips/u_datapath/clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

# Clock net "clk_run_o_BUFG" driven by instance "clk_run_o_BUFG_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_clk_run_o_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_run_o_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_run_o_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_clk_run_o_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

# Clock net "clk_i_IBUF_BUFG" driven by instance "clk_i_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_clk_i_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_i_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_i_IBUF_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_clk_i_IBUF_BUFG}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
