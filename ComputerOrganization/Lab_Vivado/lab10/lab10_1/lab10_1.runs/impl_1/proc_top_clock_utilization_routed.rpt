#startgroup
create_pblock {CLKAG_u_top/u_mips/u_datapath/next_pc_reg[31]_i_2_n_1_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_u_top/u_mips/u_datapath/next_pc_reg[31]_i_2_n_1_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_top/u_mips/u_datapath/next_pc_reg[31]_i_2_n_1_BUFG"}]]]
